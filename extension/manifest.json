{
  "manifest_version": 3,
  "name": "웹페이지 분석 도구",
  "version": "0.1.0",
  "description": "현재 페이지의 SEO·Schema·AEO/GEO·Performance·Accessibility를 즉시 점검 (LLM 없이 결정적 metric only).",
  "default_locale": "ko",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "웹페이지 분석 도구",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
